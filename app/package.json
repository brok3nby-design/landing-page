{
  "name": "brok3n-studio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BROK3N BY DESIGN interactive 3D studio website - LOCAL PROTOTYPE (Phase 5). Not connected to the production site.",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && vite build && node scripts/static-routes.mjs",
    "preview": "vite preview",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "build:staging": "npm run prepare-assets && STAGING=1 vite build && STAGING=1 node scripts/static-routes.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs --subpath",
    "deploy:staging:subdomain": "node scripts/deploy-staging.mjs",
    "test:staging": "npm run build:staging && node scripts/staging-tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.3",
    "lighthouse": "^12.6.1",
    "vite": "^6.4.5"
  }
}
